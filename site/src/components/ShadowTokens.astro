---
import { shadowSets, fixedLightSurface } from '../lib/tokens';

const sets = shadowSets();
// See the `.sample` background comment below for why this is fixed rather than themed.
const sampleSurface = fixedLightSurface();
---

<div class="panel">
	<div class="grid">
		{
			sets.map((set) => (
				<article class="card">
					<div class="sample" style={`box-shadow: ${set.css}`} />
					<p class="name">{set.name}</p>
				</article>
			))
		}
	</div>
</div>

<style define:vars={{ sampleSurface }}>
	.panel {
		margin-block: 2rem;
		padding: 24px;
		border-radius: 0.75rem;
		background: var(--sl-color-gray-6);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
		gap: 1.5rem;
	}

	/* Starlight's markdown flow puts a top margin on every sibling after the
	   first, which grid items honour — so every card but the first sat lower
	   than its row. The grid's `gap` does the spacing here. */
	.card {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.sample {
		block-size: 5rem;
		margin-block-end: 0.6rem;
		border-radius: 0.75rem;
		/* Fixed light, not a themed token: these shadows are composed from
		   literal low-alpha black (see shadow.json) with no dark-theme
		   counterpart, so the sample needs a surface that stays light in
		   both themes to remain visible. `bg-always-light` is the design
		   token reserved for exactly that case. */
		background: var(--sampleSurface);
	}

	.name {
		margin: 0;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
	}
</style>
