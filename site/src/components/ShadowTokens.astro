---
import { shadowSets } from '../lib/tokens';

const sets = shadowSets();
---

<div class="grid">
	{
		sets.map((set) => (
			<article class="card">
				<div class="sample" style={`box-shadow: ${set.css}`} />
				<p class="name">{set.name}</p>
				<p class="levels">
					{set.levels.length} {set.levels.length === 1 ? 'layer' : 'layers'}
				</p>
				<code>{set.css}</code>
			</article>
		))
	}
</div>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
		gap: 1.5rem;
		margin-block: 2rem;
	}

	.card {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.sample {
		block-size: 5rem;
		margin-block-end: 0.6rem;
		border-radius: 0.75rem;
		background: var(--sl-color-black);
	}

	.name {
		margin: 0;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
	}

	.levels {
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}

	code {
		font-size: 0.625rem;
		line-height: 1.5;
		overflow-wrap: anywhere;
		color: var(--sl-color-gray-2);
	}
</style>
