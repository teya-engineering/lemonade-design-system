# Swift/iOS/Xcode specific
# Swift Package Manager build directory
swiftui/.build/
swiftui/.swiftpm/

# Xcode project (generated by XcodeGen from project.yml)
swiftui/*.xcodeproj/

# Developer-specific signing settings, created from Local.xcconfig.template by
# scripts/generate-ios-project.sh. Holds your Apple Developer Team ID, which must
# not be committed: this repository is public.
swiftui/Local.xcconfig

# Xcode user-specific files
swiftui/**/*.xcodeproj/xcuserdata/
swiftui/**/*.xcworkspace/xcuserdata/
swiftui/**/*.xcodeproj/project.xcworkspace/xcuserdata/

# Xcode build products
swiftui/build/
swiftui/DerivedData/

# CocoaPods (if used)
swiftui/Pods/
swiftui/Podfile.lock

# Carthage (if used)
swiftui/Carthage/Build/

# Accio dependency management
swiftui/Dependencies/
swiftui/.accio/

# fastlane specific
swiftui/fastlane/report.xml
swiftui/fastlane/Preview.html
swiftui/fastlane/screenshots/**/*.png
swiftui/fastlane/test_output

# Swift Package Manager resolved file
swiftui/Package.resolved

# Claude
docs/
.claude/settings.local.json
kmp/.claude/settings.local.json
swiftui/.claude/settings.local.json
.build/
.claude/scheduled_tasks.lock

# Web package
web/node_modules/
web/dist/
web/*.tgz
web/storybook-static/

*storybook.log
