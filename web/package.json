{
  "name": "@teya/lemonade-mobile-ds",
  "version": "0.1.0",
  "description": "Lemonade mobile design system for the web \u2014 tokens, typography and icons for building Teya app prototypes",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/teya-engineering/lemonade-design-system.git",
    "directory": "web"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
